NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://apertureprism:apertureprism@127.0.0.1:5432/apertureprism
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=1000
# GITHUB_WEBHOOK_SECRET=set-a-random-secret-and-keep-it-out-of-git
# GitHub App (mints installation tokens for API reads and comment publishing)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=C:\path\to\app-private-key.pem
# Defaults to the public GitHub API; set for GitHub Enterprise.
# GITHUB_API_BASE_URL=https://api.github.com
# Map model provider names to OpenAI-compatible base URLs for the worker:
#  (base URL must include the /v1 path; adapter appends /chat/completions)
MODEL_PROVIDER_BASE_URLS={"newapi":"https://newapi.binbim.top/v1"}
# Embedding model: configured separately from the review model (own base + key).
# EMBEDDING_BASE_URL=https://newapi.binbim.top/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=nvidia/nv-embed-v1
# The API key is NOT set here. The worker decrypts it from provider_accounts
# using CREDENTIAL_MASTER_KEY below; generate one and keep it out of git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_MASTER_KEY=
# NTQQ bot gateways per protocol (onebot11 | satori | milky):
# QQ_BOT_PROTOCOLS={"onebot11":{"baseUrl":"http://127.0.0.1:3000","accessToken":"...","gatewayUrl":"ws://127.0.0.1:3001"}}
# Official QQ open-platform bot (api-v2). AppSecret is used to fetch the
# access token; it stays in env, never in the repo.
# QQ_OFFICIAL_APP_ID=
# QQ_OFFICIAL_APP_SECRET=
# Defaults to wss://api.sgroup.qq.com/websocket; override for sandbox/enterprise.
# QQ_OFFICIAL_GATEWAY_URL=
# Intents bitmask (default 1<<25 enables C2C + GROUP_AT message events).
# QQ_OFFICIAL_INTENTS=33554432
