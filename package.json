{
  "name": "apertureprism-ai-review",
  "private": true,
  "version": "1.0.15",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/analysis-worker",
    "apps/index-worker",
    "apps/qq-bot",
    "apps/scan-worker",
    "apps/scheduler"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "format": "prettier --write \"apps/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"*.{json,mjs,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"*.{json,mjs,yaml}\"",
    "setup": "node scripts/install.mjs",
    "migrate": "node scripts/migrate.mjs",
    "lint": "eslint .",
    "test": "npm run build --workspaces --if-present && vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  }
}
